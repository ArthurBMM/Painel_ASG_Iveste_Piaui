{
  "name": "asg-investe-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Ferramenta de análise ASG baseada nas Normas GRI para a Investe Piauí (protótipo web estático)",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "servir": "node tools/servir.mjs",
    "referencia": "python3 tools/referencia_pandas.py",
    "servir:python": "python -m http.server 8080",
    "cifrar-gri": "node tools/cifrar_gri.mjs",
    "conferir-gri": "node tools/cifrar_gri.mjs --conferir",
    "dicionario": "node tools/gerar_dicionario.mjs && node tools/gerar_dicionario_indicadores.mjs",
    "planilhas": "python tools/gerar_exemplo_xlsx.py"
  },
  "engines": {
    "node": ">=20"
  }
}
